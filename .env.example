# Google OAuth client IDs from Google Cloud Console.
# See README "Configure Google sign-in" for setup.
# Copy this file to .env and fill in at least the iOS client ID.

# REQUIRED (for iOS builds): iOS OAuth client.
# Type "iOS", bundle ID com.addtocalendar.rn. Must also be added to Supabase
# → Auth → Providers → Google → "Authorized Client IDs", because the iOS
# native flow's ID token has aud = this iOS client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# OPTIONAL: Web OAuth client. Only needed if you build a web version
# (`expo start --web`) or want a fallback client ID. The iOS native flow
# does NOT use this — it uses the iOS client ID above.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# OPTIONAL: Android OAuth client (type "Android", package com.addtocalendar.rn,
# with your signing SHA-1). Only needed for Android builds.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
