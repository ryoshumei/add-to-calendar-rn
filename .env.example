# Google OAuth client IDs from Google Cloud Console.
# See README "Configure Google sign-in" for setup.
# Copy this file to .env and fill in values to enable Google sign-in.

# iOS OAuth client (type "iOS", bundle ID com.addtocalendar.rn).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Web OAuth client. Required because Supabase verifies the ID token audience
# against the Web client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android OAuth client (type "Android", package com.addtocalendar.rn).
# Optional — leave blank if you're only building iOS.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
