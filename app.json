{
  "expo": {
    "name": "Add to Calendar",
    "slug": "add-to-calendar-rn",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "addtocalendar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.addtocalendar.rn",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use the camera to capture event images.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access photos to import event images.",
        "NSCalendarsUsageDescription": "Allow $(PRODUCT_NAME) to add events to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Allow $(PRODUCT_NAME) to add events to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.addtocalendar.rn",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to extract calendar events from images.",
          "cameraPermission": "The app accesses your camera to capture event images."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "The app needs to access your calendar to add events."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableExperimental": true,
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "iosShareExtensionName": "Add to Calendar Share",
          "iosAppGroupIdentifier": "group.com.addtocalendar.rn",
          "androidIntentFilters": [
            "image/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2291ff41-f8b9-49fe-87c8-02289df65db4",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "AddtoCalendarShare",
                  "bundleIdentifier": "com.addtocalendar.rn.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.addtocalendar.rn"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
